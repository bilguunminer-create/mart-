GEMINI_API_KEY=

# 100% Free Email OTP Verification (Gmail SMTP)
# 1. Use your store Gmail address
# 2. In Google Account Security > 2-Step Verification > App Passwords, generate a 16-character App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=US&K Family Mart

# OTP_SECRET: HMAC signing secret for email verification tokens
# (send-email-otp / verify-email-otp, both the Express and Vercel versions).
# Required in production: set a long random value, identical everywhere these
# endpoints run. Without it, tokens can be forged by anyone who reads the source.
OTP_SECRET=
