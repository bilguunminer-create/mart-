GEMINI_API_KEY=

# 100% Free Email OTP Verification (Gmail SMTP)
# 1. Use your store Gmail address
# 2. In Google Account Security > 2-Step Verification > App Passwords, generate a 16-character App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=US&K Family Mart

# OTP_SECRET: HMAC signing secret for email verification tokens
# (send-email-otp / verify-email-otp, both the Express and Vercel versions).
# Required in production: set a long random value, identical everywhere these
# endpoints run. Without it, tokens can be forged by anyone who reads the source.
OTP_SECRET=

# --- New-order push notifications (admin/inventory native app) ---
# api/notify-new-order.ts. If either of these is missing, the endpoint quietly
# no-ops (checkout is never blocked by this).

# SUPABASE_SERVICE_ROLE_KEY: the project's service_role key (Supabase dashboard ->
# Project Settings -> API). Server-side only — never expose this to the client,
# it bypasses row-level security. Used only to read admin_push_tokens.
SUPABASE_SERVICE_ROLE_KEY=

# FIREBASE_SERVICE_ACCOUNT_JSON: the full JSON contents (as one line) of a Firebase
# service account key, used to send push notifications via Firebase Cloud Messaging.
# Generate one at Firebase console -> Project settings -> Service accounts ->
# Generate new private key, for the same Firebase project the Android app is
# registered under. Server-side only.
FIREBASE_SERVICE_ACCOUNT_JSON=
